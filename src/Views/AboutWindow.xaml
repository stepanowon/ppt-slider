<Window x:Class="PptSlider.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PptSlider"
        Title="{local:Loc aboutTitle}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{x:Static local:L.UiFont}" FontSize="12" Background="White">
    <Border Padding="24,22,24,16">
    <DockPanel MinWidth="380">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
            <Button x:Name="CopyBtn" DockPanel.Dock="Left" Content="{local:Loc copyInfo}" Padding="12,4" Click="OnCopy" ToolTip="{local:Loc copyInfoTip}"/>
            <Button Content="{local:Loc ok}" Width="80" Padding="0,4" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"/>
        </DockPanel>

        <Image x:Name="Logo" DockPanel.Dock="Left" Width="64" Height="64" VerticalAlignment="Top" Margin="0,2,18,0"/>

        <StackPanel>
            <TextBlock Text="PPT Slider" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" FontSize="13" Foreground="#444" Margin="0,2,0,0"/>
            <TextBlock Text="{local:Loc aboutDesc}" Foreground="#444" TextWrapping="Wrap" MaxWidth="340" Margin="0,12,0,0" HorizontalAlignment="Left"/>
            <TextBlock x:Name="CopyrightText" Foreground="#444" Margin="0,12,0,0"/>
            <TextBlock Text="{local:Loc aboutLicense}" Foreground="#444" TextWrapping="Wrap" MaxWidth="340" HorizontalAlignment="Left"/>

            <StackPanel Margin="0,12,0,0">
                <TextBlock Margin="0,0,0,3"><Hyperlink NavigateUri="https://github.com/stepanowon/ppt-slider" RequestNavigate="OnLink"><Run Text="{local:Loc linkHome}"/></Hyperlink></TextBlock>
                <TextBlock Margin="0,0,0,3"><Hyperlink NavigateUri="https://apps.microsoft.com/detail/9PL1M72JXSCN" RequestNavigate="OnLink"><Run Text="{local:Loc linkStore}"/></Hyperlink></TextBlock>
                <TextBlock Margin="0,0,0,3"><Hyperlink NavigateUri="https://github.com/stepanowon/ppt-slider/blob/main/PRIVACY.md" RequestNavigate="OnLink"><Run Text="{local:Loc linkPrivacy}"/></Hyperlink></TextBlock>
                <TextBlock x:Name="NoticesLine"><Hyperlink x:Name="NoticesLink" RequestNavigate="OnLink"><Run Text="{local:Loc linkNotices}"/></Hyperlink></TextBlock>
            </StackPanel>

            <TextBlock x:Name="SystemText" Foreground="#888" Margin="0,12,0,0"/>
        </StackPanel>
    </DockPanel>
    </Border>
</Window>

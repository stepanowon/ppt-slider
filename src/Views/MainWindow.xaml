<Window x:Class="PptSlider.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PptSlider"
        Title="PPT Slider" Width="1400" Height="860" WindowStartupLocation="CenterScreen"
        FontFamily="{x:Static local:L.UiFont}" FontSize="12" Background="#F3F3F3"
        AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKey" PreviewMouseDown="OnWindowMouseDown" Closing="OnClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#C43E1C"/>
        <!-- Ribbon button: MDL2 glyph in Tag, label in Content -->
        <Style x:Key="Rb" TargetType="ButtonBase">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="6,4" MinWidth="46" Margin="1,0">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/>
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E3E3E3"/></Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="#D2D2D2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Small" TargetType="ButtonBase" BasedOn="{StaticResource Rb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Width="28" Height="26" Margin="1">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E3E3E3"/></Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="#D2D2D2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Grp" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border BorderBrush="#D6D6D6" BorderThickness="0,0,1,0" Padding="6,2">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Bottom" ContentSource="Header" HorizontalAlignment="Center" TextElement.Foreground="#666" TextElement.FontSize="11" Margin="0,2,0,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- TabItem must stay focusable: it only selects itself on mouse click by taking focus.
             Arrow keys still go to slide navigation via the window's PreviewKeyDown. -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Padding="14,6" Margin="2,0" BorderThickness="0,0,0,3" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E8E8E8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ribbon -->
        <TabControl x:Name="Ribbon" DockPanel.Dock="Top" Background="#FAFAFA" BorderThickness="0,0,0,1" BorderBrush="#D6D6D6" Padding="4,2" Height="122" Focusable="False">
            <TabItem Header="{local:Loc tab.home}">
                <StackPanel Orientation="Horizontal">
                    <HeaderedContentControl Header="{local:Loc grp.file}" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xE8E5;" Content="{local:Loc open}" Click="OnOpen" ToolTip="{local:Loc open}" local:Shortcuts.For="open"/>
                            <Button x:Name="RecentBtn" Style="{StaticResource Small}" Tag="&#xE70D;" Click="OnRecentMenu" ToolTip="{local:Loc recent}" VerticalAlignment="Top" Margin="-6,8,0,0"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE74E;" Content="{local:Loc save}" Click="OnSave" ToolTip="{local:Loc save}" local:Shortcuts.For="save"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE792;" Content="{local:Loc saveAsShort}" Click="OnSaveAs" ToolTip="{local:Loc saveAs}" local:Shortcuts.For="saveAs"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xEA90;" Content="PDF" Click="OnExportPdf" ToolTip="{local:Loc exportPdfTip}" local:Shortcuts.For="exportPdf"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE70B;" Content="{local:Loc inkNotes}" Click="OnInkNotes" ToolTip="{local:Loc inkNotesTip}" local:Shortcuts.For="inkNotes"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.edit}" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xE77F;" Content="{local:Loc paste}" Click="OnPaste" ToolTip="{local:Loc pasteTip}" local:Shortcuts.For="paste"/>
                            <StackPanel>
                                <Button Style="{StaticResource Small}" Tag="&#xE8C6;" Click="OnCut" ToolTip="{local:Loc cut}" local:Shortcuts.For="cut"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE8C8;" Click="OnCopy" ToolTip="{local:Loc copy}" local:Shortcuts.For="copy"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE771;" Click="OnFormatPainter" ToolTip="{local:Loc formatPainterTip}"/>
                            </StackPanel>
                            <StackPanel>
                                <Button Style="{StaticResource Small}" Tag="&#xE7A7;" Click="OnUndo" ToolTip="{local:Loc undo}" local:Shortcuts.For="undo"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE7A6;" Click="OnRedo" ToolTip="{local:Loc redo}" local:Shortcuts.For="redo"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.slides}" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xE710;" Content="{local:Loc newSlide}" Click="OnNewSlide" ToolTip="{local:Loc newSlideTip}" local:Shortcuts.For="newSlide"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE8C8;" Content="{local:Loc duplicate}" Click="OnDuplicate" ToolTip="{local:Loc duplicateSlide}" local:Shortcuts.For="duplicate"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE74D;" Content="{local:Loc delete}" Click="OnDeleteSlide" ToolTip="{local:Loc deleteSlide}"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.font}" Style="{StaticResource Grp}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <ComboBox x:Name="FontBox" Width="150" IsEditable="True" SelectionChanged="OnFontPicked" KeyDown="OnFontKey" ToolTip="{local:Loc grp.font}"/>
                                <ComboBox x:Name="SizeBox" Width="58" Margin="4,0,0,0" IsEditable="True" SelectionChanged="OnSizePicked" KeyDown="OnSizeKey" ToolTip="{local:Loc fontSizeTip}"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE8E8;" Click="OnGrow" ToolTip="{local:Loc grow}" local:Shortcuts.For="grow"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE8E7;" Click="OnShrink" ToolTip="{local:Loc shrink}" local:Shortcuts.For="shrink"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Button Style="{StaticResource Small}" Tag="&#xE8DD;" Click="OnBold" ToolTip="{local:Loc bold}" local:Shortcuts.For="bold"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE8DB;" Click="OnItalic" ToolTip="{local:Loc italic}" local:Shortcuts.For="italic"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE8DC;" Click="OnUnderline" ToolTip="{local:Loc underline}" local:Shortcuts.For="underline"/>
                                <Button Style="{StaticResource Small}" Tag="&#xEDE0;" Click="OnStrike" ToolTip="{local:Loc strike}" local:Shortcuts.For="strike"/>
                                <Button x:Name="ColorBtn" Style="{StaticResource Small}" Tag="&#xE8D3;" Click="OnFontColor" ToolTip="{local:Loc fontColor}"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE7E6;" Click="OnHighlight" ToolTip="{local:Loc highlight}"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.paragraph}" Style="{StaticResource Grp}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Button Style="{StaticResource Small}" Tag="&#xE8FD;" Click="OnBullets" ToolTip="{local:Loc bullets}"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE9D5;" Click="OnNumbering" ToolTip="{local:Loc numbering}"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE290;" Click="OnIndentLess" ToolTip="{local:Loc indentLess}" local:Shortcuts.For="indentLess"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE291;" Click="OnIndentMore" ToolTip="{local:Loc indentMore}" local:Shortcuts.For="indentMore"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Button Style="{StaticResource Small}" Tag="&#xE8E4;" Click="OnAlign" CommandParameter="l" ToolTip="{local:Loc alignLeft}"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE8E3;" Click="OnAlign" CommandParameter="ctr" ToolTip="{local:Loc alignCenter}"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE8E2;" Click="OnAlign" CommandParameter="r" ToolTip="{local:Loc alignRight}"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE292;" Click="OnAlign" CommandParameter="just" ToolTip="{local:Loc alignJustify}"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE8A4;" Click="OnLineSpacing" ToolTip="{local:Loc lineSpacing}"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.drawing}" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xE8D2;" Content="{local:Loc textBox}" Click="OnAddText"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xF157;" Content="{local:Loc shapes}" Click="OnShapes" ToolTip="{local:Loc shapesTip}"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xF156;" Content="{local:Loc arrange}" Click="OnArrangeMenu" ToolTip="{local:Loc arrangeTip}"/>
                            <StackPanel>
                                <Button Style="{StaticResource Small}" Tag="&#xEB9F;" Click="OnAddPicture" ToolTip="{local:Loc pictureTip}" local:Shortcuts.For="picture"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE894;" Click="OnDeleteShape" ToolTip="{local:Loc deleteShapeTip}" local:Shortcuts.For="deleteShape"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </TabItem>
            <TabItem Header="{local:Loc tab.insert}">
                <StackPanel Orientation="Horizontal">
                    <HeaderedContentControl Header="{local:Loc grp.slides}" Style="{StaticResource Grp}">
                        <Button Style="{StaticResource Rb}" Tag="&#xE710;" Content="{local:Loc newSlide}" Click="OnNewSlide" ToolTip="{local:Loc newSlideTip}" local:Shortcuts.For="newSlide"/>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.insert}" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xE80A;" Content="{local:Loc table}" Click="OnInsertTable" ToolTip="{local:Loc tableTip}"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xEB9F;" Content="{local:Loc picture}" Click="OnAddPicture" ToolTip="{local:Loc pictureTip}" local:Shortcuts.For="picture"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xF157;" Content="{local:Loc shapes}" Click="OnShapes" ToolTip="{local:Loc shapesTip}"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE8D2;" Content="{local:Loc textBox}" Click="OnAddText"/>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </TabItem>
            <TabItem Header="{local:Loc tab.format}">
                <StackPanel Orientation="Horizontal">
                    <HeaderedContentControl Header="{local:Loc grp.shapeStyle}" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xF16D;" Content="{local:Loc shapeFill}" Click="OnShapeFill" ToolTip="{local:Loc shapeFillTip}"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xF16B;" Content="{local:Loc shapeOutline}" Click="OnShapeOutline" ToolTip="{local:Loc shapeOutlineTip}"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE771;" Content="{local:Loc formatPainter}" Click="OnFormatPainter" ToolTip="{local:Loc formatPainterTip}"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.arrange}" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xE74A;" Content="{local:Loc toFront}" Click="OnFront" ToolTip="{local:Loc bringToFront}" local:Shortcuts.For="bringToFront"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE74B;" Content="{local:Loc toBack}" Click="OnBack" ToolTip="{local:Loc sendToBack}" local:Shortcuts.For="sendToBack"/>
                            <StackPanel>
                                <Button Style="{StaticResource Small}" Tag="&#xE70E;" Click="OnForward" ToolTip="{local:Loc bringForward}" local:Shortcuts.For="bringForward"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE70D;" Click="OnBackward" ToolTip="{local:Loc sendBackward}" local:Shortcuts.For="sendBackward"/>
                            </StackPanel>
                            <Button Style="{StaticResource Rb}" Tag="&#xE8A9;" Content="{local:Loc align}" Click="OnAlignMenu" ToolTip="{local:Loc alignTip}"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE7AD;" Content="{local:Loc rotate}" Click="OnRotateMenu" ToolTip="{local:Loc rotateTip}"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE894;" Content="{local:Loc deleteShape}" Click="OnDeleteShape" ToolTip="{local:Loc deleteShapeTip}" local:Shortcuts.For="deleteShape"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.table}" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xF164;" Content="{local:Loc rowAbove}" Click="OnRowAbove" ToolTip="{local:Loc rowAboveTip}"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xF164;" Content="{local:Loc rowBelow}" Click="OnRowBelow" ToolTip="{local:Loc rowBelowTip}"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xF164;" Content="{local:Loc colLeft}" Click="OnColLeft" ToolTip="{local:Loc colLeftTip}"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xF164;" Content="{local:Loc colRight}" Click="OnColRight" ToolTip="{local:Loc colRightTip}"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xF166;" Content="{local:Loc deleteRow}" Click="OnDeleteRow" ToolTip="{local:Loc deleteRowTip}"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xF166;" Content="{local:Loc deleteCol}" Click="OnDeleteCol" ToolTip="{local:Loc deleteColTip}"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE74D;" Content="{local:Loc deleteTable}" Click="OnDeleteTable"/>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </TabItem>
            <!-- ink is for the slide show: this tab shows only while a show runs (SyncDrawTools) -->
            <TabItem x:Name="DrawTab" Header="{local:Loc tab.draw}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <HeaderedContentControl Header="{local:Loc grp.tools}" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ToolSelect" Style="{StaticResource Rb}" Tag="&#xE8B0;" Content="{local:Loc select}" Click="OnTool" ToolTip="{local:Loc selectTip}" local:Shortcuts.For="select"/>
                            <RadioButton x:Name="ToolPen" Style="{StaticResource Rb}" Tag="&#xEE56;" Content="{local:Loc pen}" Click="OnTool" ToolTip="{local:Loc pen}" local:Shortcuts.For="pen"/>
                            <RadioButton x:Name="ToolHi" Style="{StaticResource Rb}" Tag="&#xE7E6;" Content="{local:Loc highlighter}" Click="OnTool" ToolTip="{local:Loc highlighter}" local:Shortcuts.For="highlighter"/>
                            <RadioButton x:Name="ToolEraser" Style="{StaticResource Rb}" Tag="&#xED60;" Content="{local:Loc eraser}" Click="OnTool" ToolTip="{local:Loc eraser}" local:Shortcuts.For="eraser"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.color}" Style="{StaticResource Grp}">
                        <WrapPanel x:Name="Swatches" Width="150" VerticalAlignment="Center"/>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.width}" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SizeSlider" Width="140" Minimum="1" Maximum="80" Focusable="False" ValueChanged="OnPenSize"/>
                            <TextBlock x:Name="SizeText" Width="30" Margin="6,0" VerticalAlignment="Center"/>
                            <Ellipse x:Name="PenPreview" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.undoClear}" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="UndoInkBtn" Style="{StaticResource Rb}" Tag="&#xE7A7;" Content="{local:Loc undoInkShort}" Click="OnUndoInk" ToolTip="{local:Loc undoInk}" local:Shortcuts.For="undo"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE75C;" Content="{local:Loc thisSlide}" Click="OnClearInk" ToolTip="{local:Loc clearInk}" local:Shortcuts.For="clearInk"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE74D;" Content="{local:Loc allInk}" Click="OnClearAllInk"/>
                            <ToggleButton x:Name="InkShownBtn" Style="{StaticResource Rb}" Tag="&#xE7B3;" Content="{local:Loc inkShown}" Click="OnInkShown" ToolTip="{local:Loc inkShownTip}" IsChecked="True"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.page}" Style="{StaticResource Grp}">
                        <Button Style="{StaticResource Rb}" Tag="&#xE7C3;" Content="{local:Loc blankPage}" Click="OnBlankPage" ToolTip="{local:Loc blankPageTip}" local:Shortcuts.For="blankPage"/>
                    </HeaderedContentControl>
                </StackPanel>
            </TabItem>
            <TabItem Header="{local:Loc tab.show}">
                <StackPanel Orientation="Horizontal">
                    <HeaderedContentControl Header="{local:Loc grp.startShow}" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xE768;" Content="{local:Loc fromStart}" Click="OnShowFirst" ToolTip="{local:Loc fromStart}" local:Shortcuts.For="showFirst"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE786;" Content="{local:Loc fromCurrent}" Click="OnShowCurrent" ToolTip="{local:Loc fromCurrent}" local:Shortcuts.For="showCurrent"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.monitor}" Style="{StaticResource Grp}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{local:Loc monitorLabel}" Foreground="#555" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="MonitorBox" Width="230" Focusable="False"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE72C;" Click="OnRefreshMonitors" ToolTip="{local:Loc refreshMonitors}"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc presenterView}" Style="{StaticResource Grp}">
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox x:Name="PresenterBox" Content="{local:Loc usePresenter}" IsChecked="True" Focusable="False"
                                      ToolTip="{local:Loc usePresenterTip}"/>
                            <TextBlock Text="{local:Loc onOtherMonitor}" Foreground="#888" Margin="20,2,0,0"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.break}" Style="{StaticResource Grp}">
                        <Button Style="{StaticResource Rb}" Tag="&#xE916;" Content="Break Time" Click="OnBreak" ToolTip="{local:Loc breakTip}" local:Shortcuts.For="break"/>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.help}" Style="{StaticResource Grp}">
                        <Button Style="{StaticResource Rb}" Tag="&#xE765;" Content="{local:Loc shortcuts}" Click="OnHelp" ToolTip="{local:Loc shortcutList}" local:Shortcuts.For="help"/>
                    </HeaderedContentControl>
                </StackPanel>
            </TabItem>
            <TabItem Header="{local:Loc tab.settings}">
                <StackPanel Orientation="Horizontal">
                    <HeaderedContentControl Header="Language / 언어 / 言語" Style="{StaticResource Grp}">
                        <StackPanel VerticalAlignment="Center">
                            <ComboBox x:Name="LanguageBox" Width="220" SelectionChanged="OnLanguagePicked" ToolTip="{local:Loc language}"/>
                            <TextBlock Text="{local:Loc languageNote}" Foreground="#888" Margin="2,4,0,0"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc shortcuts}" Style="{StaticResource Grp}">
                        <Button Style="{StaticResource Rb}" Tag="&#xE713;" Content="{local:Loc shortcutSettings}" Click="OnShortcutSettings" ToolTip="{local:Loc shortcutSettingsTip}" local:Shortcuts.For="settings"/>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="{local:Loc grp.help}" Style="{StaticResource Grp}">
                        <Button Style="{StaticResource Rb}" Tag="&#xE946;" Content="{local:Loc about}" Click="OnAbout" ToolTip="{local:Loc aboutTitle}"/>
                    </HeaderedContentControl>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Background="#ECECEC" BorderBrush="#D6D6D6" BorderThickness="0,1,0,0" Padding="10,3">
            <DockPanel>
                <TextBlock x:Name="ToolText" DockPanel.Dock="Right" Foreground="#555"/>
                <TextBlock x:Name="StatusText" Foreground="#555"/>
            </DockPanel>
        </Border>

        <!-- thumbnails -->
        <ListBox x:Name="Thumbs" DockPanel.Dock="Left" Width="220" Background="#F3F3F3" BorderThickness="0,0,1,0" BorderBrush="#D6D6D6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnThumbSelected" Focusable="False"
                 AllowDrop="True" DragOver="OnThumbsDragOver" DragLeave="OnThumbsDragLeave" Drop="OnThumbsDrop"/>

        <!-- slide stage -->
        <Grid Background="#E6E6E6">
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" FontSize="16" Foreground="#888"/>
                <TextBlock x:Name="RecentTitle" Text="{local:Loc recent}" FontSize="14" Foreground="#666" Margin="0,28,0,6"/>
                <ItemsControl x:Name="RecentList" Focusable="False"/>
            </StackPanel>
            <Viewbox Margin="28">
                <Grid x:Name="StageFrame" Visibility="Collapsed">
                    <!-- shadow on a sibling so the effect doesn't slow down rendering; ink is drawn on the screen above (InkOverlay) -->
                    <Border Background="White"><Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/></Border.Effect></Border>
                    <!-- Focusable: the caret goes here when it leaves the font / size boxes, so the slide keys reach the window -->
                    <Grid x:Name="Stage" ClipToBounds="True" Focusable="True" FocusVisualStyle="{x:Null}"
                          MouseLeftButtonDown="OnStageDown" MouseMove="OnStageMove" MouseLeftButtonUp="OnStageUp">
                        <ContentControl x:Name="SlideHost" Focusable="False"/>
                        <Canvas x:Name="Overlay" Background="Transparent"/>
                    </Grid>
                </Grid>
            </Viewbox>
        </Grid>
    </DockPanel>
</Window>

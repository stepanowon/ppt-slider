<Window x:Class="PptSlider.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PptSlider"
        Title="PPT Slider" Width="1400" Height="860" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="12" Background="#F3F3F3"
        AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKey" Closing="OnClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#C43E1C"/>
        <!-- Ribbon button: MDL2 glyph in Tag, label in Content -->
        <Style x:Key="Rb" TargetType="ButtonBase">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="6,4" MinWidth="46" Margin="1,0">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/>
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E3E3E3"/></Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="#D2D2D2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Small" TargetType="ButtonBase" BasedOn="{StaticResource Rb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Width="28" Height="26" Margin="1">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E3E3E3"/></Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="#D2D2D2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Grp" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border BorderBrush="#D6D6D6" BorderThickness="0,0,1,0" Padding="6,2">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Bottom" ContentSource="Header" HorizontalAlignment="Center" TextElement.Foreground="#666" TextElement.FontSize="11" Margin="0,2,0,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- TabItem must stay focusable: it only selects itself on mouse click by taking focus.
             Arrow keys still go to slide navigation via the window's PreviewKeyDown. -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Padding="14,6" Margin="2,0" BorderThickness="0,0,0,3" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E8E8E8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ribbon -->
        <TabControl x:Name="Ribbon" DockPanel.Dock="Top" Background="#FAFAFA" BorderThickness="0,0,0,1" BorderBrush="#D6D6D6" Padding="4,2" Height="122" Focusable="False">
            <TabItem Header="홈">
                <StackPanel Orientation="Horizontal">
                    <HeaderedContentControl Header="파일" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xE8E5;" Content="열기" Click="OnOpen" ToolTip="열기" local:Shortcuts.For="open"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE74E;" Content="저장" Click="OnSave" ToolTip="저장" local:Shortcuts.For="save"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE792;" Content="다른 이름" Click="OnSaveAs" ToolTip="다른 이름으로 저장" local:Shortcuts.For="saveAs"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="편집" Style="{StaticResource Grp}">
                        <Button Style="{StaticResource Rb}" Tag="&#xE7A7;" Content="실행 취소" Click="OnUndo" ToolTip="실행 취소" local:Shortcuts.For="undo"/>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="슬라이드" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xE710;" Content="새 슬라이드" Click="OnNewSlide" ToolTip="빈 슬라이드 추가" local:Shortcuts.For="newSlide"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE8C8;" Content="복제" Click="OnDuplicate" ToolTip="슬라이드 복제" local:Shortcuts.For="duplicate"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE74D;" Content="삭제" Click="OnDeleteSlide" ToolTip="슬라이드 삭제"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="글꼴" Style="{StaticResource Grp}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <ComboBox x:Name="FontBox" Width="150" IsEditable="True" SelectionChanged="OnFontPicked" ToolTip="글꼴"/>
                                <ComboBox x:Name="SizeBox" Width="58" Margin="4,0,0,0" IsEditable="True" SelectionChanged="OnSizePicked" KeyDown="OnSizeKey" ToolTip="글꼴 크기 (Enter로 적용)"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE8E8;" Click="OnGrow" ToolTip="글꼴 크기 크게" local:Shortcuts.For="grow"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE8E7;" Click="OnShrink" ToolTip="글꼴 크기 작게" local:Shortcuts.For="shrink"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Button Style="{StaticResource Small}" Tag="&#xE8DD;" Click="OnBold" ToolTip="굵게" local:Shortcuts.For="bold"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE8DB;" Click="OnItalic" ToolTip="기울임꼴" local:Shortcuts.For="italic"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE8DC;" Click="OnUnderline" ToolTip="밑줄" local:Shortcuts.For="underline"/>
                                <Button x:Name="ColorBtn" Style="{StaticResource Small}" Tag="&#xE8D3;" Click="OnFontColor" ToolTip="글꼴 색"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="단락" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Small}" Tag="&#xE8E4;" Click="OnAlign" CommandParameter="l" ToolTip="왼쪽 맞춤"/>
                            <Button Style="{StaticResource Small}" Tag="&#xE8E3;" Click="OnAlign" CommandParameter="ctr" ToolTip="가운데 맞춤"/>
                            <Button Style="{StaticResource Small}" Tag="&#xE8E2;" Click="OnAlign" CommandParameter="r" ToolTip="오른쪽 맞춤"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="삽입" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xE8D2;" Content="텍스트 상자" Click="OnAddText"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE894;" Content="개체 삭제" Click="OnDeleteShape" ToolTip="선택한 개체 삭제" local:Shortcuts.For="deleteShape"/>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </TabItem>
            <TabItem Header="그리기">
                <StackPanel Orientation="Horizontal">
                    <HeaderedContentControl Header="도구" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ToolSelect" Style="{StaticResource Rb}" Tag="&#xE8B0;" Content="선택" Click="OnTool" ToolTip="선택/편집 (Esc)" local:Shortcuts.For="select"/>
                            <RadioButton x:Name="ToolPen" Style="{StaticResource Rb}" Tag="&#xEE56;" Content="펜" Click="OnTool" ToolTip="펜" local:Shortcuts.For="pen"/>
                            <RadioButton x:Name="ToolHi" Style="{StaticResource Rb}" Tag="&#xE7E6;" Content="형광펜" Click="OnTool" ToolTip="형광펜" local:Shortcuts.For="highlighter"/>
                            <RadioButton x:Name="ToolEraser" Style="{StaticResource Rb}" Tag="&#xED60;" Content="지우개" Click="OnTool" ToolTip="지우개" local:Shortcuts.For="eraser"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="색" Style="{StaticResource Grp}">
                        <WrapPanel x:Name="Swatches" Width="150" VerticalAlignment="Center"/>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="두께" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SizeSlider" Width="140" Minimum="1" Maximum="80" Focusable="False" ValueChanged="OnPenSize"/>
                            <TextBlock x:Name="SizeText" Width="30" Margin="6,0" VerticalAlignment="Center"/>
                            <Ellipse x:Name="PenPreview" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="지우기" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xE75C;" Content="이 슬라이드" Click="OnClearInk" ToolTip="현재 슬라이드 판서 지우기" local:Shortcuts.For="clearInk"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE74D;" Content="모든 판서" Click="OnClearAllInk"/>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </TabItem>
            <TabItem Header="슬라이드 쇼">
                <StackPanel Orientation="Horizontal">
                    <HeaderedContentControl Header="슬라이드 쇼 시작" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xE768;" Content="처음부터" Click="OnShowFirst" ToolTip="처음부터" local:Shortcuts.For="showFirst"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE786;" Content="현재 슬라이드부터" Click="OnShowCurrent" ToolTip="현재 슬라이드부터" local:Shortcuts.For="showCurrent"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="모니터" Style="{StaticResource Grp}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="슬라이드 쇼를 표시할 모니터" Foreground="#555" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="MonitorBox" Width="230" Focusable="False"/>
                                <Button Style="{StaticResource Small}" Tag="&#xE72C;" Click="OnRefreshMonitors" ToolTip="모니터 목록 새로 고침"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="발표자 보기" Style="{StaticResource Grp}">
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox x:Name="PresenterBox" Content="발표자 보기 사용" IsChecked="True" Focusable="False"
                                      ToolTip="쇼 모니터가 아닌 모니터에 현재·다음 슬라이드, 발표자 노트, 시간을 표시합니다. 모니터가 하나면 표시하지 않습니다."/>
                            <TextBlock Text="다른 모니터에 표시" Foreground="#888" Margin="20,2,0,0"/>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="휴식" Style="{StaticResource Grp}">
                        <Button Style="{StaticResource Rb}" Tag="&#xE916;" Content="Break Time" Click="OnBreak" ToolTip="휴식 타이머" local:Shortcuts.For="break"/>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="도움말" Style="{StaticResource Grp}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Rb}" Tag="&#xE765;" Content="단축키" Click="OnHelp" ToolTip="단축키 목록" local:Shortcuts.For="help"/>
                            <Button Style="{StaticResource Rb}" Tag="&#xE713;" Content="단축키 설정" Click="OnShortcutSettings" ToolTip="단축키 바꾸기" local:Shortcuts.For="settings"/>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Background="#ECECEC" BorderBrush="#D6D6D6" BorderThickness="0,1,0,0" Padding="10,3">
            <DockPanel>
                <TextBlock x:Name="ToolText" DockPanel.Dock="Right" Foreground="#555"/>
                <TextBlock x:Name="StatusText" Foreground="#555"/>
            </DockPanel>
        </Border>

        <!-- thumbnails -->
        <ListBox x:Name="Thumbs" DockPanel.Dock="Left" Width="220" Background="#F3F3F3" BorderThickness="0,0,1,0" BorderBrush="#D6D6D6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnThumbSelected" Focusable="False"/>

        <!-- slide stage -->
        <Grid Background="#E6E6E6">
            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#888"/>
            <Viewbox Margin="28">
                <Grid x:Name="StageFrame" Visibility="Collapsed">
                    <!-- shadow on a sibling so the effect doesn't slow down inking -->
                    <Border Background="White"><Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/></Border.Effect></Border>
                    <Grid x:Name="Stage" ClipToBounds="True"
                          MouseLeftButtonDown="OnStageDown" MouseMove="OnStageMove" MouseLeftButtonUp="OnStageUp">
                        <ContentControl x:Name="SlideHost" Focusable="False"/>
                        <Canvas x:Name="Overlay" Background="Transparent"/>
                        <InkCanvas x:Name="Ink" Background="Transparent"/>
                    </Grid>
                </Grid>
            </Viewbox>
        </Grid>
    </DockPanel>
</Window>

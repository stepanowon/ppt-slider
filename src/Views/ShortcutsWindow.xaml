<Window x:Class="PptSlider.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="단축키 설정" Width="640" Height="620" MinWidth="520" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="12" Background="#F3F3F3"
        InputMethod.IsInputMethodEnabled="False" PreviewKeyDown="OnKey">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                   Text="기능을 선택하고 [추가] 또는 [바꾸기]를 누른 뒤 원하는 키 조합을 누르세요. 한 기능에 여러 키를 지정할 수 있습니다. Esc는 편집 취소·포인터·쇼 종료용으로 예약되어 있어 지정할 수 없습니다."/>

        <DockPanel x:Name="Buttons" DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Content="모두 기본값으로" Padding="12,4" Click="OnResetAll"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="확인" Width="80" Padding="0,4" IsDefault="True" Click="OnOk"/>
                <Button Content="취소" Width="80" Padding="0,4" Margin="6,0,0,0" IsCancel="True"/>
            </StackPanel>
        </DockPanel>

        <Border x:Name="CaptureBar" DockPanel.Dock="Bottom" Background="#FFF4CE" BorderBrush="#E0C060" BorderThickness="1" Padding="10,6" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="CaptureText" FontSize="13"/>
        </Border>
        <TextBlock x:Name="Message" DockPanel.Dock="Bottom" Foreground="#A33" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="110">
            <Button x:Name="AddBtn" Content="추가" Padding="0,4" Click="OnAdd"/>
            <Button x:Name="ReplaceBtn" Content="바꾸기" Padding="0,4" Margin="0,6,0,0" Click="OnReplace"/>
            <Button x:Name="ClearBtn" Content="지우기" Padding="0,4" Margin="0,6,0,0" Click="OnClear"/>
            <Button x:Name="DefaultBtn" Content="이 기능 기본값" Padding="0,4" Margin="0,6,0,0" Click="OnResetOne"/>
        </StackPanel>

        <ListView x:Name="List" SelectionMode="Single" SelectionChanged="OnSelected" MouseDoubleClick="OnReplace">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="분류" Width="70" DisplayMemberBinding="{Binding Group}"/>
                    <GridViewColumn Header="기능" Width="190" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="단축키" Width="200" DisplayMemberBinding="{Binding Keys}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
